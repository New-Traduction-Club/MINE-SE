<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layoutToolsMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tools_select_tool"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/colorPrimary"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRpycDecompiler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:strokeColor="@color/colorDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_rpyc_decompiler"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/colorTextPrimary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_rpyc_decompiler_desc"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRpaExtractor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:strokeColor="@color/colorDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_rpa_extractor"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/colorTextPrimary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_rpa_extractor_desc"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPythonRunner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:strokeColor="@color/colorDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_python_runner"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/colorTextPrimary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_python_runner_desc"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


        <LinearLayout
            android:id="@+id/layoutDecompiler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/btnBackToTools"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="@string/tools_back"
                    android:textColor="@color/color_desktop_button_outline_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_desktop_button_outline" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tools_rpyc_decompiler"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:strokeColor="@color/colorDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_input_label"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSelectedInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_no_selection"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnSelectInputFile"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/tools_select_file"
                            android:textColor="@color/color_desktop_button_outline_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_desktop_button_outline"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/btnSelectInputFolder"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/tools_select_folder"
                            android:textColor="@color/color_desktop_button_outline_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_desktop_button_outline"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:strokeColor="@color/colorDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_output_label"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSelectedOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_original_location"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnChangeOutputFolder"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/tools_change_folder"
                            android:textColor="@color/color_desktop_button_outline_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_desktop_button_outline"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/btnResetOutputFolder"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/tools_reset_default"
                            android:textColor="@color/color_desktop_button_subtle_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_desktop_button_subtle"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <CheckBox
                android:id="@+id/cbOverwriteRpy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_overwrite_rpy"
                android:checked="true"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/btnStartDecompile"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="@string/tools_start_decompile"
                android:textColor="@color/color_desktop_button_solid_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_desktop_button_solid"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/txtDecompileStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tools_ready"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginBottom="4dp" />

                <ProgressBar
                    android:id="@+id/progressBarDecompile"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log:"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginBottom="4dp" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollConsole"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@color/colorCardBackground"
                android:padding="8dp"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/txtDecompileLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="@color/colorTextPrimary"
                    android:text="@string/tools_ready" />
            </androidx.core.widget.NestedScrollView>

        </LinearLayout>


        <LinearLayout
            android:id="@+id/layoutExtractor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/btnBackToToolsExtractor"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="@string/tools_back"
                    android:textColor="@color/color_desktop_button_outline_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_desktop_button_outline" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tools_rpa_extractor"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:strokeColor="@color/colorDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_input_label"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSelectedInputExtractor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_no_selection"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnSelectInputFileExtractor"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/tools_select_file"
                            android:textColor="@color/color_desktop_button_outline_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_desktop_button_outline"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/btnSelectInputFolderExtractor"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/tools_select_folder"
                            android:textColor="@color/color_desktop_button_outline_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_desktop_button_outline"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:strokeColor="@color/colorDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_output_label"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSelectedOutputExtractor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_original_location"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnChangeOutputFolderExtractor"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/tools_change_folder"
                            android:textColor="@color/color_desktop_button_outline_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_desktop_button_outline"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/btnResetOutputFolderExtractor"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/tools_reset_default"
                            android:textColor="@color/color_desktop_button_subtle_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_desktop_button_subtle"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <CheckBox
                android:id="@+id/cbExtractorOverwrite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_overwrite_files"
                android:checked="true"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/cbExtractorSubfolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_extract_subfolder"
                android:checked="false"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/btnStartExtract"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="@string/tools_start_extract"
                android:textColor="@color/color_desktop_button_solid_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_desktop_button_solid"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/txtExtractStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tools_ready"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginBottom="4dp" />

                <ProgressBar
                    android:id="@+id/progressBarExtract"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log:"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginBottom="4dp" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollConsoleExtractor"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@color/colorCardBackground"
                android:padding="8dp"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/txtExtractLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="@color/colorTextPrimary"
                    android:text="@string/tools_ready" />
            </androidx.core.widget.NestedScrollView>

        </LinearLayout>


        <LinearLayout
            android:id="@+id/layoutPythonRunner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/btnBackToToolsPython"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="@string/tools_back"
                    android:textColor="@color/color_desktop_button_outline_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_desktop_button_outline" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tools_python_runner"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:strokeColor="@color/colorDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_python_script_label"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSelectedInputPython"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_no_selection"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/btnSelectInputFilePython"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="@string/tools_select_file"
                        android:textColor="@color/color_desktop_button_outline_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/bg_desktop_button_outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:strokeColor="@color/colorDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_python_args_label"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editPythonArgs"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:hint="@string/tools_python_args_hint"
                        android:textColorHint="@color/colorTextSecondary"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/bg_desktop_button_subtle"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:inputType="text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/btnStartPython"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="@string/tools_python_start_run"
                android:textColor="@color/color_desktop_button_solid_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_desktop_button_solid"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/txtPythonStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tools_ready"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginBottom="4dp" />

                <ProgressBar
                    android:id="@+id/progressBarPython"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Log:"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/colorTextSecondary" />

                <TextView
                    android:id="@+id/btnCopyPythonLog"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="@string/tools_python_copy_log"
                    android:textColor="@color/color_desktop_button_subtle_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_desktop_button_subtle"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnClearPythonLog"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="@string/tools_python_clear_log"
                    android:textColor="@color/color_desktop_button_subtle_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_desktop_button_subtle" />
            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollConsolePython"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@color/colorCardBackground"
                android:padding="8dp"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/txtPythonLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="@color/colorTextPrimary"
                    android:textIsSelectable="true"
                    android:text="@string/tools_ready" />
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/layoutPythonInputBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/editPythonStdin"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:hint="@string/tools_python_stdin_hint"
                    android:textColorHint="@color/colorTextSecondary"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_desktop_button_subtle"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:imeOptions="actionSend"
                    android:inputType="text" />

                <TextView
                    android:id="@+id/btnSendPythonStdin"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="@string/tools_python_send"
                    android:textColor="@color/color_desktop_button_solid_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_desktop_button_solid"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
